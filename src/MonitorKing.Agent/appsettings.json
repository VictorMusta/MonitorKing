{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1;[::1]",
  "MonitorKing": {
    "Port": 5757,
    "SampleIntervalMs": 2000,
    "SensorIntervalMs": 5000,
    "PersistEveryTicks": 5,
    "RetentionDays": 14,
    "EventRetentionDays": 90,
    "EventBackfillDays": 30,
    "DataDirectory": "",
    "MotherboardLabel": "",
    "AutoUpdate": true
  }
}
