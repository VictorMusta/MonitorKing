<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <!-- Agent installé (Release) : aucune fenêtre, il tourne en arrière-plan. En Debug, dotnet run garde la console et ses journaux. -->
    <OutputType Condition="'$(Configuration)' == 'Release'">WinExe</OutputType>
    <!-- Ramasse-miettes « station de travail » : celui « serveur » (défaut d'une appli web) garde un tas par cœur
         et rend peu la mémoire ; l'agent montait à ~1 Go sur un processeur 16 threads. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <!-- Seule source du numéro de version : scripts/release.ps1 en tire le tag, l'archive et le manifeste de mise à jour. -->
    <Version>0.4.2</Version>
    <SatelliteResourceLanguages>fr;en</SatelliteResourceLanguages>
    <AssemblyName>MonitorKing.Agent</AssemblyName>
    <RootNamespace>MonitorKing.Agent</RootNamespace>
    <!-- Le dashboard vit dans src/MonitorKing.Dashboard et est copié à côté de l'exécutable :
         pas de « static web assets » (sinon, en mode Development, ASP.NET cherche un wwwroot dans le projet). -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- Dashboard partagé avec le serveur, servi depuis le dossier de l'exécutable (marche aussi sans le code source). -->
    <Content Include="..\MonitorKing.Dashboard\wwwroot\**\*" LinkBase="wwwroot" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <!-- 3.1.22 : la dernière version qui s'appuie sur les composants de .NET 8 (les suivantes demandent System.Text.Json 9,
         absent de l'agent autonome publié). -->
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.1.22" />
    <PackageReference Include="System.Diagnostics.EventLog" Version="8.0.1" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MonitorKing.Core\MonitorKing.Core.csproj" />
    <ProjectReference Include="..\MonitorKing.Updater\MonitorKing.Updater.csproj" />
  </ItemGroup>

</Project>
