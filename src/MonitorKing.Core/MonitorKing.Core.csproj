<Project Sdk="Microsoft.NET.Sdk">

  <!-- Moteur commun à l'agent (Windows) et au serveur (Linux) : modèles, stockage, diagnostic, rapports.
       Aucune dépendance à Windows ici. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>MonitorKing.Core</RootNamespace>
    <Version>0.2.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
  </ItemGroup>

</Project>
